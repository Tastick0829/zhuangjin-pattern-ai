# ---------- 环境与密钥（绝不入库）----------
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# ---------- 运行时产物 ----------
uploads/
output/
logs/
*.log

# ---------- 模型权重（体积大，自行下载）----------
