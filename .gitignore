*.ckpt
*.pt
*.pth
*.bin

# ---------- 数据集（版权与体积原因，见 docs/dataset.md）----------
dataset/*
!dataset/README.md
!dataset/.gitkeep

# ---------- 压缩包与安装程序 ----------
*.zip
*.7z
*.rar
*.exe
*.msi

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.egg-info/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*~
