# 复制本文件为 .env 并填入你自己的密钥
# 严禁把 .env 提交到仓库（已在 .gitignore 中排除）

# FreeImageHost 图床（用于把用户上传的图片转成公网 URL 供 Liblib 拉取）
# 申请地址: https://freeimghost.net/
FREEIMGHOST_API_KEY=

# LiblibAI 开放平台密钥（用于调用 ComfyUI 工作流生成纹样）
# 申请地址: https://www.liblib.art/ （个人中心 → 开放平台）
LIBLIB_ACCESS_KEY=
LIBLIB_SECRET_KEY=

# 可选运行参数
# FLASK_DEBUG=0      # 生产环境务必保持 0
# PORT=5000